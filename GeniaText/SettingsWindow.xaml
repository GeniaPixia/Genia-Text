<Window x:Class="GeniaText.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsWindowTitle}" Width="650" Height="690"
        MinWidth="650" MinHeight="620" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Icon="pack://application:,,,/Assets/GeniaText.ico">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource SettingsHeader}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource SettingsSubtitle}"
                       FontSize="11.5" Margin="0,3,0,0" Foreground="{StaticResource TextSecondary}"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource Win7TabBorderBrush}">
            <TabItem Header="{DynamicResource SettingsGeneralTab}">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82"/>
                        <RowDefinition Height="96"/>
                        <RowDefinition Height="86"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource SettingsHotkey}" FontSize="11.5" FontWeight="SemiBold"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ModifierBox" Grid.Column="0" Style="{StaticResource EditorComboBox}" DisplayMemberPath="Label"/>
                            <ComboBox x:Name="KeyBox" Grid.Column="2" Style="{StaticResource EditorComboBox}" DisplayMemberPath="Label"/>
                        </Grid>
                        <TextBlock Grid.Row="2" FontSize="11" Foreground="{StaticResource TextSecondary}" Text="{DynamicResource SettingsHotkeyDefault}"/>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,5,0,0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="0" Padding="12,10">
                        <StackPanel>
                            <CheckBox x:Name="PortableModeCheckBox" Content="{DynamicResource SettingsPortable}" FontWeight="SemiBold"/>
                            <TextBlock Margin="19,6,0,0" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap">
                                <Run Text="{DynamicResource SettingsPortableDesc}"/>
                                <LineBreak/>
                                <Run Text="{DynamicResource SettingsPortableRestart}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="0,8,0,0" Background="White"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource SettingsLanguageLabel}"
                                           FontSize="11.5" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource SettingsLanguageHint}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" Height="32"
                                      VerticalAlignment="Center" Margin="10,0,0,0"
                                      Style="{StaticResource EditorComboBox}"
                                      DisplayMemberPath="Label"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Margin="0,12,0,0" Background="{StaticResource Win7SubtlePanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="0" Padding="12,10" VerticalAlignment="Top">
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                   Text="{DynamicResource SettingsOptionalNote}"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource SettingsFeaturesTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,14,18,18">
                        <TextBlock Text="{DynamicResource SettingsModulesHeader}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="{DynamicResource SettingsModulesHint}"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,12"/>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="EditorProCheckBox" Content="{DynamicResource SettingsEditorPro}" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="{DynamicResource SettingsEditorProDesc}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="SmartTemplatesCheckBox" Content="{DynamicResource SettingsSmartTemplates}" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="{DynamicResource SettingsSmartTemplatesDesc}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="AdvancedSearchCheckBox" Content="{DynamicResource SettingsAdvancedSearch}" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="{DynamicResource SettingsAdvancedSearchDesc}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="UsageHistoryCheckBox" Content="{DynamicResource SettingsUsageHistory}" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="{DynamicResource SettingsUsageHistoryDesc}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="AppProfilesCheckBox" Content="{DynamicResource SettingsAppProfiles}" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="{DynamicResource SettingsAppProfilesDesc}"/>
                                <TextBlock Margin="19,8,0,4" FontSize="11" FontWeight="SemiBold" Text="{DynamicResource SettingsAppRules}"/>
                                <TextBox x:Name="AppProfileRulesBox" Margin="19,0,0,0" Height="70" AcceptsReturn="True" MaxLength="32768"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Style="{StaticResource EditorTextBox}"
                                         IsEnabled="{Binding IsChecked, ElementName=AppProfilesCheckBox}"
                                         ToolTip="Пример: chrome=Web&#x0a;telegram=Telegram"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="CompatibilityModeCheckBox" Content="{DynamicResource SettingsCompatibility}" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="{DynamicResource SettingsCompatibilityDesc}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="AdvancedBackupsCheckBox" Content="{DynamicResource SettingsAdvancedBackups}" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="{DynamicResource SettingsAdvancedBackupsDesc}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="RecycleBinCheckBox" Content="{DynamicResource SettingsRecycleBin}" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="{DynamicResource SettingsRecycleBinDesc}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="BackupBrowserCheckBox" Content="{DynamicResource SettingsBackupBrowser}" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="{DynamicResource SettingsBackupBrowserDesc}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12">
                            <StackPanel>
                                <CheckBox x:Name="ImportPreviewCheckBox" Content="{DynamicResource SettingsImportPreview}" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="{DynamicResource SettingsImportPreviewDesc}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Style="{StaticResource DefaultButton}" Content="{DynamicResource SettingsCancel}" MinWidth="82" Padding="12,5" Margin="0,0,7,0" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource SettingsSave}" MinWidth="96" Padding="12,5" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
