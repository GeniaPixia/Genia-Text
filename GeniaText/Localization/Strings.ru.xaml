<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="SettingsWindowTitle">Настройки — GeniaText</sys:String>
    <sys:String x:Key="SettingsHeader">Настройки GeniaText</sys:String>
    <sys:String x:Key="SettingsSubtitle">Основной быстрый сценарий остается прежним. Дополнительные модули включаются отдельно.</sys:String>
    <sys:String x:Key="SettingsGeneralTab">Основные</sys:String>
    <sys:String x:Key="SettingsFeaturesTab">Возможности</sys:String>
    <sys:String x:Key="SettingsHotkey">Горячая клавиша открытия</sys:String>
    <sys:String x:Key="SettingsHotkeyDefault">По умолчанию: Ctrl+Space</sys:String>
    <sys:String x:Key="SettingsPortable">Портативный режим</sys:String>
    <sys:String x:Key="SettingsPortableDesc">Фразы, настройки, резервные копии и журнал хранятся рядом с GeniaText.exe.</sys:String>
    <sys:String x:Key="SettingsPortableRestart">Изменение применяется после перезапуска.</sys:String>
    <sys:String x:Key="SettingsOptionalNote">Все дополнительные возможности на соседней вкладке по умолчанию выключены. Если их не включать, GeniaText работает по тому же базовому сценарию: Ctrl+Space → выбор фразы → Enter/Space.</sys:String>
    <sys:String x:Key="SettingsModulesHeader">Подключаемые модули</sys:String>
    <sys:String x:Key="SettingsModulesHint">Выключенный модуль не участвует в основном сценарии работы.</sys:String>
    <sys:String x:Key="SettingsEditorPro">Редактор Pro</sys:String>
    <sys:String x:Key="SettingsEditorProDesc">Отдельное окно для пакетной смены категории, управления избранным и безопасного поиска повторяющихся фраз.</sys:String>
    <sys:String x:Key="SettingsSmartTemplates">Умные шаблоны</sys:String>
    <sys:String x:Key="SettingsSmartTemplatesDesc">Подстановка {date}, {time} и {datetime} непосредственно перед вставкой. Неизвестные конструкции остаются без изменений.</sys:String>
    <sys:String x:Key="SettingsAdvancedSearch">Расширенный поиск</sys:String>
    <sys:String x:Key="SettingsAdvancedSearchDesc">Поиск по нескольким словам и осторожная коррекция небольших опечаток в названии, категории и тексте.</sys:String>
    <sys:String x:Key="SettingsUsageHistory">История использования</sys:String>
    <sys:String x:Key="SettingsUsageHistoryDesc">Запоминает только локально время и количество успешных вставок и добавляет фильтр «Недавние».</sys:String>
    <sys:String x:Key="SettingsAppProfiles">Профили приложений</sys:String>
    <sys:String x:Key="SettingsAppProfilesDesc">При открытии окна выбора фраз автоматически выбирает категорию для приложения, из которого был вызван GeniaText.</sys:String>
    <sys:String x:Key="SettingsAppRules">Правила: process=категория</sys:String>
    <sys:String x:Key="SettingsCompatibility">Расширенная совместимость вставки</sys:String>
    <sys:String x:Key="SettingsCompatibilityDesc">Добавляет дополнительную попытку вернуть фокус перед Ctrl+V. Включайте только если стандартная вставка нестабильна в конкретной программе.</sys:String>
    <sys:String x:Key="SettingsAdvancedBackups">Расширенные резервные копии</sys:String>
    <sys:String x:Key="SettingsAdvancedBackupsDesc">Во время изменений делает периодическую копию phrases.json не чаще одного раза в 10 минут и хранит до 30 копий.</sys:String>
    <sys:String x:Key="SettingsRecycleBin">Корзина удалённых фраз</sys:String>
    <sys:String x:Key="SettingsRecycleBinDesc">Удаление из редактора сначала сохраняет локальную копию фразы в корзине. Восстановление открывается отдельной кнопкой.</sys:String>
    <sys:String x:Key="SettingsBackupBrowser">Просмотр резервных копий</sys:String>
    <sys:String x:Key="SettingsBackupBrowserDesc">Показывает локальные копии из папки Backups, позволяет восстановить фразу или всю копию и удалить выбранную копию. В обычном режиме хранится до 10 копий; при расширенном — до 30.</sys:String>
    <sys:String x:Key="SettingsImportPreview">Безопасный предпросмотр импорта</sys:String>
    <sys:String x:Key="SettingsImportPreviewDesc">Перед импортом показывает новые фразы, точные повторы и конфликты ID. До подтверждения база не меняется.</sys:String>
    <sys:String x:Key="SettingsCancel">Отмена</sys:String>
    <sys:String x:Key="SettingsSave">Сохранить</sys:String>
    <sys:String x:Key="PickerHint">Выберите фразу и нажмите Enter или Space</sys:String>
    <sys:String x:Key="PickerManage">Фразы</sys:String>
    <sys:String x:Key="PickerEmpty">Фразы не найдены</sys:String>
    <sys:String x:Key="PickerFooter">↑↓ — выбор   Enter / Space — вставить   Esc — скрыть</sys:String>
    <sys:String x:Key="PickerInsert">Вставить</sys:String>
    <sys:String x:Key="SettingsLanguageLabel">Язык интерфейса</sys:String>
    <sys:String x:Key="SettingsLanguageHint">Авто: русский Windows → RU; остальные → EN</sys:String>
    <sys:String x:Key="LanguageAutomatic">Автоматически</sys:String>
    <sys:String x:Key="LanguageRestartNotice">Язык интерфейса изменён. Для применения перезапустите GeniaText.</sys:String>
    <sys:String x:Key="TrayOpen">Открыть GeniaText</sys:String>
    <sys:String x:Key="TrayEditor">Редактор фраз</sys:String>
    <sys:String x:Key="TraySettings">Настройки</sys:String>
    <sys:String x:Key="TrayAutostart">Автозапуск</sys:String>
    <sys:String x:Key="TrayExit">Выход</sys:String>
    <sys:String x:Key="EditorTitle">Управление фразами — GeniaText</sys:String>
    <sys:String x:Key="EditorHeading">Управление фразами</sys:String>
    <sys:String x:Key="EditorHint">Редактирование, импорт, экспорт, восстановление и настройки.</sys:String>
    <sys:String x:Key="EditorProButton">Редактор Pro</sys:String>
    <sys:String x:Key="EditorTrashButton">Корзина</sys:String>
    <sys:String x:Key="EditorBackupsButton">Резервные копии</sys:String>
    <sys:String x:Key="EditorImportButton">Импорт</sys:String>
    <sys:String x:Key="EditorExportButton">Экспорт</sys:String>
    <sys:String x:Key="EditorSettingsButton">Настройки</sys:String>
    <sys:String x:Key="EditorReorderHint">Перетащите фразу или используйте кнопки ниже</sys:String>
    <sys:String x:Key="EditorAddButton">Добавить</sys:String>
    <sys:String x:Key="EditorDuplicateButton">Копия</sys:String>
    <sys:String x:Key="EditorDeleteButton">Удалить</sys:String>
    <sys:String x:Key="EditorMoveUpButton">↑ Выше</sys:String>
    <sys:String x:Key="EditorMoveDownButton">↓ Ниже</sys:String>
    <sys:String x:Key="EditorNameLabel">Название (необязательно)</sys:String>
    <sys:String x:Key="EditorCategoryLabel">Категория (необязательно)</sys:String>
    <sys:String x:Key="EditorFavoriteCheck">★ Избранное</sys:String>
    <sys:String x:Key="EditorBodyLabel">Текст фразы</sys:String>
    <sys:String x:Key="EditorCloseButton">Закрыть</sys:String>
    <sys:String x:Key="EditorSaveButton">Сохранить</sys:String>
    <sys:String x:Key="ProTitle">Редактор Pro — GeniaText</sys:String>
    <sys:String x:Key="ProHeading">Редактор Pro</sys:String>
    <sys:String x:Key="ProHint">Выберите несколько фраз с Ctrl или Shift и примените действие ко всей группе.</sys:String>
    <sys:String x:Key="ProBatchHeading">Пакетные действия</sys:String>
    <sys:String x:Key="ProNoneSelected">Фразы не выбраны</sys:String>
    <sys:String x:Key="ProNewCategory">Новая категория</sys:String>
    <sys:String x:Key="ProApplyCategory">Назначить категорию</sys:String>
    <sys:String x:Key="ProFavorite">★ Добавить</sys:String>
    <sys:String x:Key="ProUnfavorite">Убрать ★</sys:String>
    <sys:String x:Key="ProDuplicatesHeading">Проверка повторов</sys:String>
    <sys:String x:Key="ProDuplicatesHint">Сравнивается полный текст без крайних пробелов; переносы строк Windows и Unix считаются одинаковыми. Регистр сохраняется.</sys:String>
    <sys:String x:Key="ProFindDuplicates">Найти и выделить дубли</sys:String>
    <sys:String x:Key="ProDone">Готово</sys:String>
    <sys:String x:Key="ImportTitle">Предпросмотр импорта — GeniaText</sys:String>
    <sys:String x:Key="ImportHeading">Предпросмотр импорта</sys:String>
    <sys:String x:Key="ImportHint">Файл проверен. До выбора действия текущая база не меняется.</sys:String>
    <sys:String x:Key="ImportResultCol">Результат</sys:String>
    <sys:String x:Key="ImportPhraseCol">Фраза</sys:String>
    <sys:String x:Key="ImportCategoryCol">Категория</sys:String>
    <sys:String x:Key="ImportSafetyHint">Предпросмотр информационный: выбранное действие применит весь проверенный файл. При добавлении конфликтующие ID будут заменены безопасными новыми ID.</sys:String>
    <sys:String x:Key="ImportCancel">Отмена</sys:String>
